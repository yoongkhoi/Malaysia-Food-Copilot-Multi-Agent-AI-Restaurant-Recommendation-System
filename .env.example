# Required for intent understanding and the final recommendation. Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Per-step sampling. Intent and tool choice stay low. The written recommendation is warmer.
TEMPERATURE_INTENT=0.1
TEMPERATURE_TOOLS=0.2
TEMPERATURE_RANK=0.2
TEMPERATURE_SYNTHESIS=0.7
TEMPERATURE_GENERAL=0.5

# The normal chat path. Set false only to force the older deterministic graph.
ENABLE_AGENT_WORKFLOW=true
DEMO_DATASET=false

# Retrieval and search used by the demo process.
ENABLE_LLM_INTENT_PARSER=false
ENABLE_LLM_AGENT=false
ENABLE_BM25=true
ENABLE_MULTILINGUAL_EMBEDDINGS=false
ENABLE_HYBRID_RETRIEVAL=false
ENABLE_LANGGRAPH=true
ENABLE_WEB_SEARCH=true

# Neon pooled Postgres and Redis. Do not commit real values.
DATABASE_URL=
REDIS_URL=

# Local demo only. A browser user id is not an account. Leave this false for any shared deployment.
ALLOW_UNAUTHENTICATED_MEMORY=false

# Redis session bounds. Cleanup is off unless explicitly enabled. It never runs FLUSHDB or FLUSHALL.
SESSION_TTL_SECONDS=86400
SESSION_MESSAGE_LIMIT=10
SESSION_MESSAGE_MAX_CHARS=2000
PREFERENCE_VALUE_MAX_CHARS=200
PREFERENCE_LIMIT=20
REDIS_STARTUP_CLEANUP=false

# Browser origins allowed to call the API. A wildcard is ignored.
# Credentials are not accepted. Add the real site origin before deployment.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
